#!/usr/bin/env bash

clear

if command -v cc >/dev/null 2>&1; then
    compiler=cc
elif command -v gcc >/dev/null 2>&1; then
    compiler=gcc
else
    printf 'c: neither cc nor gcc was found in PATH.\n' >&2
    exit 127
fi

flags=(-Werror -Wextra -Wall)
args=()

for arg in "$@"; do
    case "$arg" in
        -NoFlags) flags=() ;;
        *) args+=("$arg") ;;
    esac
done

printf 'c: Starting compilation...\n' >&2
printf 'c: Command:' >&2
printf ' %q' "$compiler" "${flags[@]}" "${args[@]}" >&2
printf '\n' >&2

"$compiler" "${flags[@]}" "${args[@]}"
status=$?

if [ "$status" -eq 0 ]; then
    printf 'c: Compilation succeeded.\n' >&2
else
    printf 'c: Compilation failed (exit code %d).\n' "$status" >&2
fi

exit "$status"
